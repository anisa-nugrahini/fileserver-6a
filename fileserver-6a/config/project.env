# Konfigurasi proyek 6A. Semua nilai dapat dioverride lewat environment variable.
# Tidak berisi rahasia. Password TIDAK disimpan di sini.
: "${SHARE_DIR:=/srv/fileserver/share}"
: "${BACKUP_DIR:=/var/backups/fileserver}"
: "${RESTORE_DIR:=/tmp/fileserver-restore}"
: "${OUT_DIR:=$PROJECT_ROOT/output}"
: "${LOG_DIR:=$PROJECT_ROOT/logs}"
: "${LOCK_FILE:=/tmp/fileserver-backup.lock}"
: "${SERVICES:=smbd ssh}"            # nama unit systemd (Ubuntu)
: "${SERVICE_PORTS:=445 22}"
: "${GRP_OPERATOR:=sf_operator}"
: "${GRP_READER:=sf_reader}"
: "${GRP_ADMIN:=sf_admin}"
: "${USER_OPERATOR:=sfop1}"
: "${USER_READER:=sfread1}"
: "${USER_OUTSIDER:=sfout1}"
: "${USER_ADMIN:=sfadmin1}"
: "${USER_REGULAR:=sfuser1}"
: "${DOCKER_IMAGE:=alpine:3.20}"      # catat tag yang dipakai di README
