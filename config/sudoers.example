# /etc/sudoers.d/sf_admin (periksa dengan: visudo -cf)
%sf_admin ALL=(root) /usr/local/sbin/fs-backup.sh, /usr/local/sbin/fs-restore.sh, /usr/local/sbin/fs-check.sh, /usr/local/sbin/fs-logtest.sh, /usr/bin/systemctl start smbd, /usr/bin/systemctl stop smbd, /usr/bin/systemctl status smbd, /usr/bin/systemctl status smbd --no-pager
